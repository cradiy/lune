# Terminfo description for Lune (xterm-kitty compatible)
# Compile with: tic -x -o assets/terminfo assets/terminfo/xterm-kitty.terminfo
xterm-kitty|Lune terminal (xterm-kitty compatible),
	use=xterm-256color,
	RGB,
	Su,
	Sync,
	Tc,
	fullkbd,
	Ms=\E]52;%p1%s;%p2%s\E\\,
	Se=\E[2 q,
	Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%d%;m,
	Smulx=\E[4:%p1%dm,
	Ss=\E[%p1%d q,
	ritm=\E[23m,
	rmul=\E[24m,
	rmxx=\E[29m,
	setrgbb=\E[48:2::%p1%d:%p2%d:%p3%dm,
	setrgbf=\E[38:2::%p1%d:%p2%d:%p3%dm,
	sitm=\E[3m,
	smul=\E[4m,
	smxx=\E[9m,
